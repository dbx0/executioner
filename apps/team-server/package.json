{
  "name": "@exe/team-server",
  "version": "0.0.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "executioner-host": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm --filter @exe/desktop run build:web && tsc -b",
    "dev": "pnpm build && node dist/cli.js serve",
