    "start:mac": "node dist/cli.js serve --open",
    "test": "vitest run"
  },
  "dependencies": {
    "@exe/engine-supervisor": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  }
}
